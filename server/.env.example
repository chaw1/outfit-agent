# 实际凭证仅通过进程环境注入；不要保存到此文件。
MOCK_PROVIDERS=1
# 留空关闭 /admin 与全部 /api/admin/*；启用时仅从进程环境注入口令。
ADMIN_TOKEN=
PUBLIC_BASE_URL=http://localhost:18080
API_PORT=18080
API_BIND=127.0.0.1
POSTGRES_PORT=18432
TEXT_MODEL=deepseek-flash
VISION_MODEL=qwen3-vl-plus
IMAGE_MODEL=wan2.7-image-pro
VIDEO_MODEL=wan2.6-i2v-flash
MODEL_BUDGET_CNY=12
ENVIRONMENT=development
RATE_LIMIT_REGISTER=120
RATE_LIMIT_LOGIN=120
RATE_LIMIT_UPLOAD=60
RATE_LIMIT_MESSAGES=120
RATE_LIMIT_WINDOW_SECONDS=60
MAX_UPLOAD_BYTES=15728640
MAX_UPLOAD_EDGE=6000
# 生产环境必须在进程环境设置 JWT_SECRET、POSTGRES_PASSWORD、API_BIND=127.0.0.1。
