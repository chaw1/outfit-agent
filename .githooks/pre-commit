#!/usr/bin/env bash
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"
check_app=0
check_server=0

# Include deletions and both paths of cross-directory renames.
while IFS= read -r -d '' path; do
  case "$path" in
    app/*) check_app=1 ;;
    server/*) check_server=1 ;;
  esac
done < <(git diff --cached --name-only --no-renames -z)

if [[ "$check_app" == 1 ]]; then
  echo '提交检查：App ESLint + TypeScript'
  (cd app && npm run lint && npm run typecheck)
fi

if [[ "$check_server" == 1 ]]; then
  echo '提交检查：服务端 ruff'
  (cd server && uv run ruff check .)
fi
